# GlassBox configuration. Copy to .env. Never commit real keys.
# (LLM provider keys/models are added in Phase 4, API server settings in Phase 2.)

# --- API server (Phase 2) ---
# Bind address is always 127.0.0.1 unless GLASSBOX_ALLOW_REMOTE=true, which REQUIRES SANDBOX_MODE=docker.
GLASSBOX_HOST=127.0.0.1
GLASSBOX_PORT=8000
GLASSBOX_ALLOW_REMOTE=false
SANDBOX_MODE=subprocess
GLASSBOX_DOCKER_IMAGE=glassbox-runner
GLASSBOX_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
GLASSBOX_MAX_RUNS=4
GLASSBOX_RUN_STORE_SIZE=20
GLASSBOX_RUN_TTL_S=3600
# Optional: also write every run's events to <dir>/<run_id>.ndjson
# GLASSBOX_RUNS_DIR=runs
# strict | sampled | off  (event validation against the Pydantic schema)
GLASSBOX_VALIDATE_EVENTS=sampled
